{
  "name": "@inv/license-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/dev.ts",
    "build": "esbuild src/index.ts src/create-admin.ts --bundle --platform=node --format=esm --external:@hono/node-server --external:better-auth --external:hono --external:kysely --external:pg --external:zod --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/index.mjs",
    "create-admin": "node dist/create-admin.mjs",
    "generate-keys": "tsx src/generate-keys.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@inv/license-core": "workspace:*",
    "better-auth": "^1.7.15",
    "hono": "^4.13.14",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "*",
    "otpauth": "^9.5.2",
    "tsx": "^4.23.15"
  }
}
