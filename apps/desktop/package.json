{
  "name": "@inv/desktop",
  "productName": "Inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory management for shops",
  "author": "Inventory",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/require-release-keys.mjs && electron-vite build && electron-builder --win",
    "test:e2e": "electron-vite build && playwright test",
    "publish-update": "node scripts/publish-update.mjs",
    "demo": "tsx scripts/demo.mts",
    "screens": "tsx scripts/demo-screens.mts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@inv/api": "workspace:*",
    "@inv/contracts": "workspace:*",
    "@inv/db": "workspace:*",
    "@inv/license-core": "workspace:*",
    "@inv/web": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "axe-core": "^4.11.0",
    "otpauth": "^9.5.2"
  }
}
