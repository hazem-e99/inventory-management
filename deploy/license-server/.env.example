# Copy to .env on the server. Never commit the real file.
LICENSE_DOMAIN=licenses.example.com
POSTGRES_PASSWORD=
# From: pnpm --filter @inv/license-server generate-keys
LICENSE_PRIVATE_KEY=
SERIAL_HMAC_KEY=
BETTER_AUTH_SECRET=
